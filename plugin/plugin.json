{
  "id": "audigon",
  "name": "Audigon",
  "description": "Per-app volumes, live meters and a mixer that balances groups of apps, like game and voice chat, from one dot",
  "version": "0.1.0",
  "author": "Aneesh Bhave",
  "icon": "volume_up",
  "type": "composite",
  "capabilities": ["dankbar-widget", "daemon"],
  "components": {
    "widget": "./AudigonWidget.qml",
    "daemon": "./AudigonDaemon.qml"
  },
  "settings": "./AudigonSettings.qml",
  "requires_dms": ">=2.0.0",
  "permissions": ["settings_read", "settings_write"]
}
